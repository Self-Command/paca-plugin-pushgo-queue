{
  "id": "com.selfcommand.pushgo-queue",
  "displayName": "PushGo 提醒队列",
  "description": "按任务安排发送 PushGo 提醒，支持优先级和可选拍照打卡。",
  "version": "0.1.0",
  "minCoreVersion": "v0.18.6",
  "permissions": [
    "db.read",
    "db.write",
    "events.subscribe"
  ],
  "customPermissions": [
    {
      "key": "pushgo_queue.read",
      "label": "查看提醒设置与投递记录",
      "scope": "project"
    },
    {
      "key": "pushgo_queue.manage",
      "label": "管理提醒与频道",
      "scope": "project"
    },
    {
      "key": "pushgo_queue.worker_manage",
      "label": "Manage companion worker credentials",
      "scope": "global"
    }
  ],
  "backend": {
    "allowedConfigKeys": [
      "ENCRYPTION_KEY",
      "PUBLIC_URL"
    ],
    "eventSubscriptions": [
      "task.created",
      "task.updated",
      "task.deleted"
    ],
    "routes": [
      {
        "method": "GET",
        "path": "/health",
        "public": true
      },
      {
        "method": "GET",
        "path": "/projects/:projectId/status",
        "middlewares": [
          {
            "name": "optionalAuthn"
          },
          {
            "name": "requireFreshPassword"
          },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": [
              "pushgo_queue.read"
            ]
          }
        ]
      },
      {
        "method": "POST",
        "path": "/admin/worker-credential",
        "middlewares": [
          {
            "name": "optionalAuthn"
          },
          {
            "name": "requireFreshPassword"
          },
          {
            "name": "requirePermissions",
            "scope": "global",
            "permissions": [
              "pushgo_queue.worker_manage"
            ]
          }
        ]
      },
      {
        "method": "GET",
        "path": "/worker/control",
        "public": true
      },
      {
        "method": "GET",
        "path": "/projects/:projectId/settings",
        "middlewares": [
          {
            "name": "optionalAuthn"
          },
          {
            "name": "requireFreshPassword"
          },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": [
              "pushgo_queue.read"
            ]
          }
        ]
      },
      {
        "method": "PUT",
        "path": "/projects/:projectId/settings",
        "middlewares": [
          {
            "name": "optionalAuthn"
          },
          {
            "name": "requireFreshPassword"
          },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": [
              "pushgo_queue.manage"
            ]
          }
        ]
      },
      {
        "method": "GET",
        "path": "/projects/:projectId/jobs",
        "middlewares": [
          {
            "name": "optionalAuthn"
          },
          {
            "name": "requireFreshPassword"
          },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": [
              "pushgo_queue.read"
            ]
          }
        ]
      },
      {
        "method": "POST",
        "path": "/projects/:projectId/jobs/:jobId/retry",
        "middlewares": [
          {
            "name": "optionalAuthn"
          },
          {
            "name": "requireFreshPassword"
          },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": [
              "pushgo_queue.manage"
            ]
          }
        ]
      },
      {
        "method": "GET",
        "path": "/projects/:projectId/tasks/:taskId/reminders",
        "middlewares": [
          {
            "name": "optionalAuthn"
          },
          {
            "name": "requireFreshPassword"
          },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": [
              "pushgo_queue.read"
            ]
          }
        ]
      },
      {
        "method": "PUT",
        "path": "/projects/:projectId/tasks/:taskId/reminders",
        "middlewares": [
          {
            "name": "optionalAuthn"
          },
          {
            "name": "requireFreshPassword"
          },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": [
              "pushgo_queue.manage"
            ]
          }
        ]
      },
      {
        "method": "GET",
        "path": "/projects/:projectId/tasks/:taskId/deliveries",
        "middlewares": [
          {
            "name": "optionalAuthn"
          },
          {
            "name": "requireFreshPassword"
          },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": [
              "pushgo_queue.read"
            ]
          }
        ]
      }
    ],
    "sensitiveFields": {
      "worker_settings": [
        "secret_enc"
      ],
      "project_settings": [
        "password_enc"
      ]
    }
  },
  "frontend": {
    "remoteEntryUrl": "/plugins/com.selfcommand.pushgo-queue/assets/remoteEntry.js",
    "extensionPoints": [
      {
        "point": "project.settings.tab",
        "component": "SettingsTab",
        "label": "PushGo 提醒队列",
        "order": 120,
        "requiredPermission": "pushgo_queue.read"
      },
      {
        "point": "task.detail.section",
        "component": "TaskReminderSection",
        "label": "PushGo 提醒",
        "order": 120,
        "requiredPermission": "pushgo_queue.read"
      }
    ]
  },
  "mcp": {
    "remoteEntryUrl": "/plugins-mcp/com.selfcommand.pushgo-queue/mcp.js"
  }
}
