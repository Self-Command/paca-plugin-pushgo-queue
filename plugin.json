{
  "id": "com.selfcommand.pushgo-queue",
  "displayName": "PushGo 提醒队列",
  "description": "Independent integration with durable companion worker.",
  "version": "0.1.0",
  "minCoreVersion": "v0.18.6",
  "permissions": [
    "db.read",
    "db.write",
    "events.subscribe"
  ],
  "customPermissions": [
    {
      "key": "pushgo_queue.read",
      "label": "View PushGo 提醒队列",
      "scope": "project"
    },
    {
      "key": "pushgo_queue.manage",
      "label": "Manage PushGo 提醒队列",
      "scope": "project"
    }
  ],
  "backend": {
    "allowedConfigKeys": [
      "ENCRYPTION_KEY",
      "PUBLIC_URL"
    ],
    "eventSubscriptions": [],
    "routes": [
      {
        "method": "GET",
        "path": "/health",
        "public": true
      },
      {
        "method": "GET",
        "path": "/projects/:projectId/status",
        "middlewares": [
          {
            "name": "optionalAuthn"
          },
          {
            "name": "requireFreshPassword"
          },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": [
              "pushgo_queue.read"
            ]
          }
        ]
      }
    ]
  },
  "frontend": {
    "remoteEntryUrl": "/plugins/com.selfcommand.pushgo-queue/assets/remoteEntry.js",
    "extensionPoints": [
      {
        "point": "project.settings.tab",
        "component": "SettingsTab",
        "label": "PushGo 提醒队列",
        "order": 120,
        "requiredPermission": "pushgo_queue.read"
      }
    ]
  }
}
