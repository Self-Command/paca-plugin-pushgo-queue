# Store the generated .env as root:root mode 0600; never commit it.
PACA_DEPLOY_ROOT=/opt/paca-task-platform
PUBLIC_URL=https://task.spacedo.org
STORAGE_PUBLIC_URL=https://task.spacedo.org/storage
CORS_ORIGINS=https://task.spacedo.org
COOKIE_SECURE=true
TZ=Asia/Shanghai
SITE_ADDRESS=:80
WORKER_CONCURRENCY=1
POSTGRES_USER=paca
POSTGRES_DB=paca
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
JWT_SECRET=REPLACE_WITH_RANDOM_HEX
ENCRYPTION_KEY=REPLACE_WITH_64_HEX
INTERNAL_API_KEY=REPLACE_WITH_RANDOM_HEX
AGENT_API_KEY=REPLACE_WITH_RANDOM_HEX
STORAGE_ACCESS_KEY_ID=REPLACE_WITH_RANDOM_HEX
STORAGE_SECRET_ACCESS_KEY=REPLACE_WITH_RANDOM_HEX
BACKUP_DIR=/opt/paca-task-platform/backups
BACKUP_RETENTION_DAYS=14
# Fill official image digests from Action's official-images.json, never latest.
PACA_API_IMAGE=REPLACE_WITH_DIGEST
PACA_WEB_IMAGE=REPLACE_WITH_DIGEST
PACA_REALTIME_IMAGE=REPLACE_WITH_DIGEST
PACA_AGENT_RUNNER_IMAGE=REPLACE_WITH_DIGEST
AGENT_SERVER_IMAGE=REPLACE_WITH_DIGEST
TASKNOTES_WORKER_IMAGE=REPLACE_WITH_MATCHING_A_RELEASE_DIGEST
PUSHGO_WORKER_IMAGE=REPLACE_WITH_MATCHING_B_RELEASE_DIGEST
TASKNOTES_DATABASE_URL=postgres://tasknotes_worker:REPLACE@postgres:5432/paca?sslmode=disable
PUSHGO_DATABASE_URL=postgres://pushgo_worker:REPLACE@postgres:5432/paca?sslmode=disable
